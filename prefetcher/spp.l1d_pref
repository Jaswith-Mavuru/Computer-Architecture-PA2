#include "cache.h"
#include <iostream>
#include <iomanip>
#include <algorithm>
#define IP_TRACKER_COUNT 64
#define PATTERN_TABLE_SIZE 1024
#define SIG_MASK (PATTERN_TABLE_SIZE - 1)
#define EPOCH_ACCESSES 1024

#define ACC_HIGH 0.70f
#define ACC_MED  0.40f
#define ACC_LOW  0.20f

struct PT_ENTRY {
    int8_t  stride;
    uint8_t conf;
};

class IP_TRACKER {
public:
    uint8_t  valid;
    uint16_t ip;
    uint64_t last_cl_addr;
    int8_t   last_stride;
    uint16_t signature;
    uint8_t  uniform_conf;
    uint8_t  non_uniform_mode;
    uint8_t  lru;

    IP_TRACKER() {
        valid = 0;
        ip = 0;
        last_cl_addr = 0;
        last_stride = 0;
        signature = 0;
        uniform_conf = 0;
        non_uniform_mode = 0;
        lru = 0;
    }
};
// seperate tracker tables and statistics for each cpu
IP_TRACKER trackers[NUM_CPUS][IP_TRACKER_COUNT];
PT_ENTRY   pattern_table[NUM_CPUS][PATTERN_TABLE_SIZE];
uint32_t epoch_accesses[NUM_CPUS];
uint64_t tracked_pf_fills[NUM_CPUS];
uint64_t last_epoch_fill[NUM_CPUS];
uint64_t last_epoch_useful[NUM_CPUS];
int      current_degree[NUM_CPUS];
uint64_t degree_count[NUM_CPUS][5];

// update using latest stride
inline uint16_t next_signature(uint16_t old_sig, int8_t stride) {
    return ((old_sig << 2) ^ (stride & 0x1F)) & SIG_MASK;
}

void CACHE::l1d_prefetcher_initialize()
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
    
    for (int i = 0; i < IP_TRACKER_COUNT; i++) {
        trackers[cpu][i].valid = 0;
        trackers[cpu][i].ip = 0;
        trackers[cpu][i].last_cl_addr = 0;
        trackers[cpu][i].last_stride = 0;
        trackers[cpu][i].signature = 0;
        trackers[cpu][i].uniform_conf = 0;
        trackers[cpu][i].non_uniform_mode = 0;
        trackers[cpu][i].lru = i;
    }
    for (int i = 0; i < PATTERN_TABLE_SIZE; i++) {
        pattern_table[cpu][i].stride = 0;
        pattern_table[cpu][i].conf = 0;
    }

    epoch_accesses[cpu]    = 0;
    tracked_pf_fills[cpu]  = 0;
    last_epoch_fill[cpu]   = 0;
    last_epoch_useful[cpu] = 0;
    current_degree[cpu]    = 3;

    for(int d = 0; d <= 4; d++) degree_count[cpu][d] = 0;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    // IP is shortened to 16 bits to keep the tracker entry small
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;
    uint16_t masked_ip = (uint16_t)(ip & 0xFFFF);

    epoch_accesses[cpu]++;
    if (epoch_accesses[cpu] >= EPOCH_ACCESSES) {
        // every epoch, recompute prefetch accuracy and adjust aggressiveness accordingly
        uint64_t total_fills  = (pf_fill > 0) ? pf_fill : tracked_pf_fills[cpu];
        uint64_t epoch_fills  = (total_fills >= last_epoch_fill[cpu]) ? (total_fills - last_epoch_fill[cpu]) : 0;
        uint64_t epoch_useful = (pf_useful >= last_epoch_useful[cpu]) ? (pf_useful - last_epoch_useful[cpu]) : 0;

        if (epoch_fills >= 8) {
            float accuracy = (float)epoch_useful / (float)epoch_fills;
            if (accuracy >= ACC_HIGH) current_degree[cpu] = 4;
            else if (accuracy >= ACC_MED) current_degree[cpu] = 3;
            else if (accuracy >= ACC_LOW) current_degree[cpu] = 2;
            else current_degree[cpu] = 1;
        }
        else if (total_fills == 0) current_degree[cpu] = 3;
        degree_count[cpu][current_degree[cpu]]++;
        epoch_accesses[cpu]    = 0;
        last_epoch_fill[cpu]   = total_fills;
        last_epoch_useful[cpu] = pf_useful;
    }

    int index = -1;
    for (int i = 0; i < IP_TRACKER_COUNT; i++) {
        if (trackers[cpu][i].valid && trackers[cpu][i].ip == masked_ip) {
            index = i;
            break;
        }
    }

    if (index == -1) {
        // miss in tracker: evict LRU entry and install this IP fresh with no history
        for (int i = 0; i < IP_TRACKER_COUNT; i++) {
            if (!trackers[cpu][i].valid || trackers[cpu][i].lru == (IP_TRACKER_COUNT - 1)) {
                index = i;
                break;
            }
        }
        trackers[cpu][index].valid = 1;
        trackers[cpu][index].ip = masked_ip;
        trackers[cpu][index].last_cl_addr = cl_addr;
        trackers[cpu][index].last_stride = 0;
        trackers[cpu][index].uniform_conf = 0;
        trackers[cpu][index].non_uniform_mode = 0;
        trackers[cpu][index].signature = 0;

        for (int i = 0; i < IP_TRACKER_COUNT; i++) {
            if (trackers[cpu][i].lru < trackers[cpu][index].lru) trackers[cpu][i].lru++;
        }
        trackers[cpu][index].lru = 0;
        return;
    }

    int64_t raw_stride = (cl_addr > trackers[cpu][index].last_cl_addr)
                         ? (int64_t)(cl_addr - trackers[cpu][index].last_cl_addr)
                         : -((int64_t)(trackers[cpu][index].last_cl_addr - cl_addr));

    if (raw_stride == 0) return; // ignore duplicate accesses to the same cache line

    for (int i = 0; i < IP_TRACKER_COUNT; i++) {
        if (trackers[cpu][i].lru < trackers[cpu][index].lru) trackers[cpu][i].lru++;
    }
    trackers[cpu][index].lru = 0;

    // strides beyond ±63 are too large to encode in 7 bits; reset this IP's history
    if (raw_stride < -63 || raw_stride > 63) {
        trackers[cpu][index].last_cl_addr = cl_addr;
        trackers[cpu][index].last_stride = 0;
        trackers[cpu][index].uniform_conf = 0;
        trackers[cpu][index].non_uniform_mode = 0;
        trackers[cpu][index].signature = 0;
        return;
    }

    int8_t stride = (int8_t)raw_stride;
    uint16_t old_sig = trackers[cpu][index].signature;
    bool spt_hit = false;

    if (old_sig != 0) {
        // update pattern table: saturating increment on match, decrement on mismatch (replace on zero)
        uint32_t pt_idx = old_sig & SIG_MASK;
        if (pattern_table[cpu][pt_idx].stride == stride) {
            spt_hit = true;
            if (pattern_table[cpu][pt_idx].conf < 3) pattern_table[cpu][pt_idx].conf++;
        }
        else {
            if (pattern_table[cpu][pt_idx].conf == 0) {
                pattern_table[cpu][pt_idx].stride = stride;
                pattern_table[cpu][pt_idx].conf = 1;
            }
            else pattern_table[cpu][pt_idx].conf--;
        }
    }

    // uniform_conf tracks how many consecutive accesses shared the same stride
    // non_uniform_mode is set when the stride changes but the pattern table already knows it
    if (stride == trackers[cpu][index].last_stride) {
        if (trackers[cpu][index].uniform_conf < 3) trackers[cpu][index].uniform_conf++;
        if (trackers[cpu][index].uniform_conf == 3) trackers[cpu][index].non_uniform_mode = 0;
    }
    else {
        trackers[cpu][index].uniform_conf = 0;
        if (spt_hit) trackers[cpu][index].non_uniform_mode = 1;
    }

    trackers[cpu][index].last_stride = stride;
    trackers[cpu][index].last_cl_addr = cl_addr;
    trackers[cpu][index].signature = next_signature(old_sig, stride);

    if (MSHR.occupancy >= (MSHR.SIZE - 2)) return;

    uint64_t curr_pf_cl = cl_addr;
    uint16_t temp_sig   = trackers[cpu][index].signature;

    // uniform mode: repeat the last stride non-uniform: follow the pattern table chain
    bool uniform_mode = (trackers[cpu][index].uniform_conf >= 1) &&
                        (trackers[cpu][index].non_uniform_mode == 0);

    for (int i = 0; i < current_degree[cpu]; i++) {
        int8_t pred_stride = 0;
        
        if (uniform_mode) {
            pred_stride = trackers[cpu][index].last_stride;
        }
        else {
            uint32_t look_idx = temp_sig & SIG_MASK;
            if (pattern_table[cpu][look_idx].conf >= 2) {
                pred_stride = pattern_table[cpu][look_idx].stride;
                temp_sig = next_signature(temp_sig, pred_stride);
            }
            else break;
        }

        if (pred_stride == 0) break;

        curr_pf_cl += pred_stride;
        uint64_t pf_address = curr_pf_cl << LOG2_BLOCK_SIZE;

        if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE)) break; // don't cross page boundary

        int fill_level = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
        prefetch_line(ip, addr, pf_address, fill_level, 0);
    }
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
    if (prefetch) tracked_pf_fills[cpu]++;
}

void CACHE::l1d_prefetcher_final_stats()
{
    uint64_t total_fills = (pf_fill > 0) ? pf_fill : tracked_pf_fills[cpu];

    double final_acc = (total_fills > 0)? (100.0 * (double)pf_useful / (double)total_fills): 0.0;

    std::cout << "CPU " << cpu
              << " L1D SPP Final Stats | Ending Degree: "
              << current_degree[cpu]
              << " | PF Issued: " << pf_issued
              << " | PF Useful: " << pf_useful
              << " | Accuracy: " << std::fixed
              << std::setprecision(2) << final_acc << "%"
              << std::endl;

    std::cout << "Degree 1 selections: "
              << degree_count[cpu][1] << std::endl;
    std::cout << "Degree 2 selections: "
              << degree_count[cpu][2] << std::endl;
    std::cout << "Degree 3 selections: "
              << degree_count[cpu][3] << std::endl;
    std::cout << "Degree 4 selections: "
              << degree_count[cpu][4] << std::endl;
}
